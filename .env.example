# PostgreSQL (LOW-owned database only — never point at DSD or GSC databases)
POSTGRES_USER=low
POSTGRES_PASSWORD=change-me-low-db-password
POSTGRES_DB=low

# Local Next.js / Prisma on the host → published port 5433
# Inside Docker Compose services, use host `postgres` and port 5432 instead.
DATABASE_URL=postgresql://low:change-me-low-db-password@127.0.0.1:5433/low

# App
APP_URL=http://127.0.0.1:8082
PORT=8082

# Single-admin cookie auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# DSD read-only M2M (server-only — never NEXT_PUBLIC_)
DSD_BASE_URL=http://localhost:3000
DSD_LOW_API_TOKEN=replace-with-a-long-random-token
DSD_REQUEST_TIMEOUT_MS=10000
DSD_SYNC_PAGE_SIZE=100

# GSC read-only M2M (server-only — never NEXT_PUBLIC_)
GSC_BASE_URL=http://localhost:3001
GSC_LOW_API_TOKEN=replace-with-a-long-random-token
GSC_REQUEST_TIMEOUT_MS=15000
GSC_SYNC_PAGE_SIZE=100
GSC_LIFECYCLE_CONCURRENCY=2
GSC_LIFECYCLE_MAX_PROPERTIES_PER_RUN=20

# Unified sync worker (separate process; disable with WORKER_ENABLED=false)
WORKER_ENABLED=true
WORKER_TIMEZONE=Europe/Belgrade
WORKER_STARTUP_DELAY_SECONDS=20
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_STALE_HEARTBEAT_SECONDS=120
WORKER_SHUTDOWN_TIMEOUT_SECONDS=90
WORKER_JOB_TIMEOUT_MINUTES=40
WORKER_ERROR_BACKOFF_SECONDS=60
WORKER_MAX_ERROR_BACKOFF_SECONDS=900
DSD_SYNC_INTERVAL_MINUTES=15
DSD_FULL_RECONCILIATION_HOUR=3
GSC_PROPERTIES_SYNC_INTERVAL_HOURS=6
GSC_FULL_RECONCILIATION_HOUR=4
GSC_LIFECYCLE_SYNC_HOUR=5
JOB_LOCK_DSD_TTL_MINUTES=45
JOB_LOCK_GSC_PROPERTIES_TTL_MINUTES=45
JOB_LOCK_GSC_LIFECYCLE_TTL_MINUTES=45
